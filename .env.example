# ============================================================================
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.
# ============================================================================

# --- Microsoft Foundry project ---------------------------------------------
# Overview page of your Foundry project in the portal.
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Model deployment name (Models + endpoints tab in your Foundry project).
MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Google Drive MCP server -----------------------------------------------
# Defaults are correct for the official Google Drive remote MCP server.
# The Google OAuth token is sent in the MCP tool `authorization` field (NOT in
# headers — Foundry blocks sensitive headers).
MCP_SERVER_URL=https://drivemcp.googleapis.com/mcp/v1
MCP_SERVER_LABEL=google_drive

# Optional advanced auth alternatives (leave both empty to use the default
# inline-token flow above):
#   MCP_PROJECT_CONNECTION_ID -> store the credential in a Foundry project
#     connection (create it in the portal: Connect a tool > MCP). The connection
#     carries the auth, so the local Google token is not sent from this app.
#   MCP_CONNECTOR_ID -> use a native Foundry connector instead of a raw URL,
#     e.g. connector_googledrive. The Google token is still sent inline.
# MCP_PROJECT_CONNECTION_ID=
# MCP_CONNECTOR_ID=connector_googledrive

# Optional: comma-separated allow-list of MCP tools (empty = allow all).
# Available: search_files,read_file_content,get_file_metadata,get_file_permissions,
#            list_recent_files,download_file_content,create_file,copy_file
# MCP_ALLOWED_TOOLS=search_files,read_file_content,get_file_metadata,list_recent_files

# Tool-call approval: "never" (service runs MCP tools directly) or "always"
# (the app auto-approves each call and logs it). Default: never.
MCP_REQUIRE_APPROVAL=never

# --- Google OAuth 2.0 -------------------------------------------------------
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json
# Where the cached user token is stored after the consent flow.
GOOGLE_TOKEN_PATH=token.json
# Local OAuth callback port (0 = pick a free port automatically).
GOOGLE_OAUTH_PORT=0

# --- Agent ------------------------------------------------------------------
AGENT_NAME=gdrive-mcp-agent
