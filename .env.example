# ============================================================================
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real credentials.
# ============================================================================

# --- Microsoft Foundry project ---------------------------------------------
# Overview page of your Foundry project in the portal (Endpoint), e.g.
#   https://<account>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name (Models + endpoints tab in your Foundry project).
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# --- Self-hosted Google Drive MCP server (Azure App Service) ----------------
# This is OUR OWN MCP server (see webapp/). It holds the Google identity
# server-side, so no Google token is sent from this client and the agent works
# from the Foundry portal too. The URL carries a shared secret (?key=...), so
# keep it here in .env and never commit it.
#   https://<app>.azurewebsites.net/mcp?key=<shared-secret>
MCP_SERVER_URL=https://<app>.azurewebsites.net/mcp?key=<shared-secret>
MCP_SERVER_LABEL=google_drive

# Optional advanced auth alternatives (leave empty for the default URL mode):
#   MCP_PROJECT_CONNECTION_ID -> store the URL/credential in a Foundry project
#     connection instead of putting the secret in this URL.
#   MCP_CONNECTOR_ID          -> use a native Foundry connector.
# MCP_PROJECT_CONNECTION_ID=
# MCP_CONNECTOR_ID=

# Optional: comma-separated allow-list of MCP tools (empty = allow all).
# Available: search_files,list_files,get_file_content
# MCP_ALLOWED_TOOLS=search_files,list_files,get_file_content

# Tool-call approval: "never" (service runs MCP tools directly, recommended for
# the portal) or "always" (the SDK app auto-approves each call and logs it).
MCP_REQUIRE_APPROVAL=never

# --- Google OAuth 2.0 (only for `python main.py auth` + the secrets script) --
# These are used to mint token.json locally; the resulting refresh token is then
# pushed to the App Service by scripts/set_appservice_secrets.ps1.
GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_OAUTH_PORT=8765

# --- Agent ------------------------------------------------------------------
AGENT_NAME=gdrive-mcp-agent
